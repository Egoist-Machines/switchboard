{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Passport OpenCode plugin options",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "preference",
          "fact",
          "project",
          "relationship",
          "instruction",
          "event",
          "purchase",
          "claim",
          "other"
        ]
      },
      "default": [
        "preference",
        "fact",
        "project",
        "instruction"
      ]
    },
    "ambient": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "maxRows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 6
        },
        "maxChars": {
          "type": "integer",
          "minimum": 400,
          "maximum": 20000,
          "default": 2000
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 200,
          "maximum": 10000,
          "default": 1500
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "hostedFallback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
